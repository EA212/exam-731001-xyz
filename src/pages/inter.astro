---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Astro Interactive">
  <main>
    <div id="loading" class="skeleton-container">
      <!-- Title skeleton -->
      <div class="skeleton-title"></div>

      <!-- Description skeleton -->
      <div class="skeleton-description">
        <div class="skeleton-line skeleton-line-long"></div>
        <div class="skeleton-line skeleton-line-medium"></div>
        <div class="skeleton-line skeleton-line-short"></div>
      </div>

      <!-- Cards skeleton -->
      <ul class="skeleton-card-grid">
        <li class="skeleton-card">
          <div class="skeleton-card-header"></div>
          <div class="skeleton-card-line"></div>
          <div class="skeleton-card-line skeleton-card-line-short"></div>
        </li>
        <li class="skeleton-card">
          <div class="skeleton-card-header"></div>
          <div class="skeleton-card-line"></div>
          <div class="skeleton-card-line skeleton-card-line-short"></div>
        </li>
        <li class="skeleton-card">
          <div class="skeleton-card-header"></div>
          <div class="skeleton-card-line"></div>
          <div class="skeleton-card-line skeleton-card-line-short"></div>
        </li>
      </ul>
    </div>
    <div id="content" style="display: none;">
      <h1>Interactive <span id="title"></span></h1>
      <p class="instructions" id="description"></p>
      <ul role="list" class="link-card-grid" id="cards-list"></ul>
    </div>
  </main>
</Layout>

<script>
  interface CardData {
    href: string;
    title: string;
    body: string;
  }

  interface DescriptionData {
    title: string;
    titleHtml: string;
    text: string;
    code: string;
  }

  // Fetch data from API routes
  async function loadData() {
    const loadingElement = document.getElementById("loading");
    const contentElement = document.getElementById("content");

    try {
      // Fetch cards data
      const cardsResponse = await fetch("/api/cards");
      if (!cardsResponse.ok) {
        throw new Error(
          `Failed to fetch cards: ${cardsResponse.status} ${cardsResponse.statusText}`
        );
      }
      const cards: CardData[] = await cardsResponse.json();

      // Fetch description data
      const descriptionResponse = await fetch("/api/description");
      if (!descriptionResponse.ok) {
        throw new Error(
          `Failed to fetch description: ${descriptionResponse.status} ${descriptionResponse.statusText}`
        );
      }
      const description: DescriptionData = await descriptionResponse.json();

      // Update title
      const titleElement = document.getElementById("title");
      if (titleElement) {
        titleElement.innerHTML = description.titleHtml;
      }

      // Update description
      const descriptionElement = document.getElementById("description");
      if (descriptionElement) {
        descriptionElement.innerHTML = `
          ${description.text}<br />
          <strong>API Routes:</strong>
          <span>${description.code}</span>
        `;
      }

      // Render cards
      const cardsList = document.getElementById("cards-list");
      if (cardsList) {
        cardsList.innerHTML = cards
          .map(
            (card) => `
            <li class="link-card">
              <a href="${card.href}">
                <h2>
                  <span>${card.title}</span>
                  <span>&rarr;</span>
                </h2>
                <p>${card.body}</p>
              </a>
            </li>
          `
          )
          .join("");
      }

      // Hide loading and show content
      if (loadingElement) {
        loadingElement.style.display = "none";
      }
      if (contentElement) {
        contentElement.style.display = "block";
      }
    } catch (error) {
      console.error("Error loading data:", error);
      // Hide loading on error
      if (loadingElement) {
        loadingElement.style.display = "none";
      }
      const main = document.querySelector("main");
      if (main) {
        main.innerHTML = `
          <h1>Error</h1>
          <p>Failed to load data. Please refresh the page.</p>
        `;
      }
    }
  }

  // Load data when page is ready
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", loadData);
  } else {
    loadData();
  }
</script>
