---
import Layout from '../layouts/Layout.astro';
import { themes } from '../themes';

export const prerender = true;
---

<Layout title="首页">
  <main class="home-page">
    <h1>专插本资料库</h1>
    <p class="home-lead">历年真题与背诵资料，按科目、类别、年份检索，支持在线答题与错题复习。</p>
    <div class="home-actions">
      <a class="zsb-btn primary" href="/zsb/">进入资料库</a>
      <a class="zsb-btn" href="/zsb/wrong/">错题本</a>
    </div>

    <section class="home-themes">
      <h2>答题主题</h2>
      <p class="home-themes-lead">主题是独立的一层，进入后是全屏的游戏世界；标准模式保持原本的答题节奏，随时切换。</p>
      <div class="home-theme-grid">
        {themes.map((t) => (
          <a class="home-theme" href={`/zsb/?theme=${t.id}`} style={`--accent:${t.accent}`}>
            <b>{t.name}</b>
            <small>{t.tagline}</small>
            <span class="home-theme-go">进入 →</span>
          </a>
        ))}
        <a class="home-theme is-base" href="/zsb/?theme=none">
          <b>标准模式</b>
          <small>不叠加主题，保持原本的答题节奏</small>
          <span class="home-theme-go">进入 →</span>
        </a>
      </div>
    </section>
  </main>
</Layout>
