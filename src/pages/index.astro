---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";

// Get server-side render time
const renderTime = new Date();
const formattedTime = renderTime.toLocaleString("en-US", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
  hour: "2-digit",
  minute: "2-digit",
  second: "2-digit",
  hour12: false,
});

// 页面友好名称（没有配置的页面会自动用 URL 生成）
const PAGE_LABELS: Record<string, string> = {
  "/zsb/": "专插本资料库",
  "/dg/": "考试大纲 · 资料",
  "/md/": "Markdown 示例",
  "/mdx/": "MDX 示例",
  "/static/": "静态页面示例",
  "/components/": "组件示例",
  "/inter/": "交互示例",
};

// 自动扫描 src/pages 目录（含子目录的 index 页），排除首页、api 与动态路由
// 注：Astro 5 中 Astro.glob() 已废弃，改用 import.meta.glob（.astro 模块会带 url 字段）
type PageModule = { url?: string };
const modules = import.meta.glob(["./*.astro", "./**/index.astro"], {
  eager: true,
}) as Record<string, PageModule>;

const globbed = Object.values(modules);

const seen = new Set<string>();
const pages = globbed
  .filter((page) => typeof page.url === "string")
  .map((page) => {
    const url = page.url as string;
    return {
      url,
      title: PAGE_LABELS[url] || url.replace(/^\/|\/$/g, "").toUpperCase(),
    };
  })
  .filter((page) => page.url !== "/" && !page.url.startsWith("/api"))
  // 动态路由（含 `[`）没有固定 URL，跳过
  .filter((page) => !page.url.includes("["))
  .filter((page) => {
    if (seen.has(page.url)) return false;
    seen.add(page.url);
    return true;
  })
  // 资料库放最前面
  .sort((a, b) => (a.url === "/zsb/" ? -1 : b.url === "/zsb/" ? 1 : 0));
---

<Layout title="Welcome to Astro.">
  <main>
    <h1>Welcome to <span class="text-gradient">Astro</span></h1>
    <p class="instructions">
      Check out the <code>src/pages</code> directory to get started.<br />
      <strong>Code Challenge:</strong> Tweak the "Welcome to Astro" message above.<br
      />
      <strong>Server Render Time:</strong>
      <span class="render-time">{formattedTime}</span>
    </p>
    <h2>Pages</h2>
    <ul role="list" class="link-card-grid">
      {pages.map((page) => (
        <Card href={page.url} title={page.title} body={`Visit ${page.url}`} />
      ))}
    </ul>

    <h2>Resources</h2>
    <ul role="list" class="link-card-grid">
      <Card
        href="https://docs.astro.build/"
        title="Documentation"
        body="Learn how Astro works and explore the official API docs."
      />
      <Card
        href="https://astro.build/integrations/"
        title="Integrations"
        body="Supercharge your project with new frameworks and libraries."
      />
      <Card
        href="https://astro.build/themes/"
        title="Themes"
        body="Explore a galaxy of community-built starter themes."
      />
      <Card
        href="https://astro.build/chat/"
        title="Chat"
        body="Come say hi to our amazing Discord community. ❤️"
      />
    </ul>
  </main>
</Layout>

<style>
  :root {
    --astro-gradient: linear-gradient(0deg, #4f39fa, #da62c4);
  }

  h1 {
    margin: 2rem 0;
    text-align: center;
  }

  main {
    margin: auto;
    padding: 1em;
    max-width: calc(60ch + 80px);
  }

  .text-gradient {
    font-weight: 900;
    background-image: var(--astro-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-size: 100% 200%;
    background-position-y: 100%;
    border-radius: 0.4rem;
    animation: pulse 4s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      background-position-y: 0%;
    }
    50% {
      background-position-y: 80%;
    }
  }

  .instructions {
    line-height: 1.6;
    margin: 1rem 0;
    border: 1px solid rgba(var(--accent-light), 25%);
    background: linear-gradient(
      rgba(var(--accent-dark), 66%),
      rgba(var(--accent-dark), 33%)
    );
    padding: 1.5rem;
    border-radius: 0.5rem;
    color: var(--color-text);
  }

  .instructions code {
    font-size: 0.8em;
    font-weight: 700;
    background: rgba(var(--accent-light), 12%);
    color: rgb(var(--accent-light));
    border-radius: 4px;
    padding: 0.3em 0.4em;
  }

  .instructions strong {
    color: rgb(var(--accent-light));
  }

  .render-time {
    color: rgb(var(--accent-light));
    font-family: Menlo, Monaco, "Courier New", monospace;
    font-size: 0.9em;
    font-weight: 600;
  }

  .link-card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(24ch, 1fr));
    gap: 1rem;
    padding: 0;
  }
</style>
