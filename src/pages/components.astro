---
import Layout from "../layouts/Layout.astro";
import ReactCard from "../components/ReactCard";
import VueCard from "../components/VueCard.vue";
import SvelteCard from "../components/SvelteCard.svelte";

// Get server-side render time
const renderTime = new Date();
const formattedTime = renderTime.toLocaleString("en-US", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
  hour: "2-digit",
  minute: "2-digit",
  second: "2-digit",
  hour12: false,
});
---

<Layout title="Astro Components">
  <main>
    <h1>Astro <span class="text-gradient">Components</span></h1>
    <p class="instructions">
      Astro supports multiple component frameworks.<br />
      <strong>Framework Flexibility:</strong> Use React, Vue, Svelte, and more in
      your Astro pages.<br />
      <strong>Server Render Time:</strong>
      <span class="render-time">{formattedTime}</span>
    </p>
    <ul role="list" class="link-card-grid">
      <ReactCard
        client:load
        href="https://docs.astro.build/en/guides/integrations-guide/react/"
        title="React"
        body="Build interactive UI with React components. Perfect for complex state management."
      />
      <VueCard
        client:load
        href="https://docs.astro.build/en/guides/integrations-guide/vue/"
        title="Vue"
        body="Use Vue's reactive system and component composition in your Astro projects."
      />
      <SvelteCard
        client:load
        href="https://docs.astro.build/en/guides/integrations-guide/svelte/"
        title="Svelte"
        body="Compile away the framework with Svelte's zero-runtime approach."
      />
    </ul>
  </main>
</Layout>
