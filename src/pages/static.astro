---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';

export const prerender = true;
---

<Layout title="Astro Configuration">
  <main>
    <h1>Astro <span class="text-gradient">Configuration</span></h1>
    <p class="instructions">
      This is a static page pre-rendered at build time.<br />
      <strong>Static:</strong> Using <code>export const prerender = true</code>.
    </p>
    <ul role="list" class="link-card-grid">
      <Card
        href="https://docs.astro.build/en/guides/configuring-astro/"
        title="Astro Config"
        body="Configure your Astro project with astro.config.mjs. Set integrations, adapters, and build options."
      />
      <Card
        href="https://docs.astro.build/en/reference/configuration-reference/"
        title="Config Reference"
        body="Complete reference for all available configuration options in Astro."
      />
      <Card
        href="https://docs.astro.build/en/guides/environment-variables/"
        title="Env Variables"
        body="Use .env files to manage secrets and configuration across different environments."
      />
    </ul>
  </main>
</Layout>
