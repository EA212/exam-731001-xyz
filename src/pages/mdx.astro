---
import Layout from '../layouts/Layout.astro';
import { getEntry, render } from 'astro:content';

export const prerender = true;

// Get MDX content
const mdxEntry = await getEntry('examples', 'mdx');
if (!mdxEntry) throw new Error('mdx entry not found');
const { Content } = await render(mdxEntry);
---

<Layout title="MDX Example">
  <main class="markdown-container">
    <Content />
  </main>
</Layout>
