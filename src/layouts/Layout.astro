---
import '../styles/site.css';

export interface Props {
  title: string;
}

const { title } = Astro.props as Props;
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

const demos: Record<string, string> = {
  '/dg': 'DG 示例',
  '/md': 'Markdown 示例',
  '/mdx': 'MDX 示例',
  '/static': '静态页示例',
  '/components': '组件示例',
  '/inter': '交互示例'
};

const crumbs: { label: string; href?: string }[] = [];
if (path !== '/') {
  crumbs.push({ label: '首页', href: '/' });
  if (path === '/zsb') {
    crumbs.push({ label: '资料库' });
  } else if (path === '/zsb/wrong') {
    crumbs.push({ label: '资料库', href: '/zsb/' }, { label: '错题本' });
  } else if (path.startsWith('/zsb/')) {
    crumbs.push({ label: '资料库', href: '/zsb/' }, { label: title });
  } else {
    crumbs.push({ label: demos[path] ?? title });
  }
}

const inDocs = path.startsWith('/zsb') && path !== '/zsb/wrong';
const inWrong = path === '/zsb/wrong';
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | 专插本资料库</title>
    <meta name="description" content={title + " · 专插本历年真题与资料的结构化题库"} />
    <meta name="keywords" content="专插本, 题库, 真题, 民法, 政治理论" />
    <link rel="alternate" type="application/rss+xml" title="专插本资料库 RSS" href="/rss.xml" />
    <script is:inline>
      (() => {
        const KEY = 'zsb.night.v1';
        const root = document.documentElement;
        const meta = document.querySelector('meta[name="theme-color"]');
        const mq = matchMedia('(prefers-color-scheme: dark)');
        const apply = (dark) => {
          root.dataset.night = dark ? 'dark' : 'light';
          meta?.setAttribute('content', dark ? '#000000' : '#ffffff');
        };
        let pref = null;
        try { pref = localStorage.getItem(KEY); } catch (e) {}
        apply(pref ? pref === 'dark' : mq.matches);
        mq.addEventListener?.('change', (e) => { if (!pref) apply(e.matches); });
        document.addEventListener('click', (e) => {
          if (!e.target.closest?.('#night-toggle')) return;
          const dark = root.dataset.night !== 'dark';
          apply(dark);
          pref = dark ? 'dark' : 'light';
          try { localStorage.setItem(KEY, pref); } catch (err) {}
        });
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="site-brand" href="/">专插本资料库</a>
        <nav class="site-nav" aria-label="主导航">
          <a href="/zsb/" class={inDocs ? 'site-nav-link is-current' : 'site-nav-link'} aria-current={inDocs ? 'page' : undefined}>资料库</a>
          <a href="/zsb/wrong/" class={inWrong ? 'site-nav-link is-current' : 'site-nav-link'} aria-current={inWrong ? 'page' : undefined}>错题本</a>
        </nav>
        <a class="legacy-entry" href="/zz/zsb/" title="适老化 / 旧浏览器基础版">长者版</a>
        <button class="night-toggle" id="night-toggle" type="button" aria-label="切换夜间模式" title="切换夜间模式">
          <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
          <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" /></svg>
        </button>
      </div>
    </header>

    {crumbs.length > 0 && (
      <nav class="site-crumb" aria-label="面包屑">
        <div class="site-crumb-inner">
          {crumbs.map((c, i) => (
            <Fragment>
              {i > 0 && <span class="site-crumb-sep">/</span>}
              {c.href ? (
                <a href={c.href}>{c.label}</a>
              ) : (
                <span class="site-crumb-current" aria-current="page">{c.label}</span>
              )}
            </Fragment>
          ))}
        </div>
      </nav>
    )}

    <slot />
  </body>
</html>
