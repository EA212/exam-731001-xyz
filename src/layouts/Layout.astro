---
import '../styles/site.css';

export interface Props {
  title: string;
}

const { title } = Astro.props as Props;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | 专插本资料库</title>
    <meta name="description" content={title + " · 专插本历年真题与资料的结构化题库"} />
    <meta name="keywords" content="专插本, 题库, 真题, 民法, 政治理论" />
    <link rel="alternate" type="application/rss+xml" title="专插本资料库 RSS" href="/rss.xml" />
  </head>
  <body>
    <a class="legacy-entry" href="/l/" title="适老化 / 旧浏览器基础版">长者版</a>
    <slot />
  </body>
</html>
