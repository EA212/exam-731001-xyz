---
import '../styles/site.css';

export interface Props {
  title: string;
}

const { title } = Astro.props as Props;
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

const demos: Record<string, string> = {
  '/dg': 'DG 示例',
  '/md': 'Markdown 示例',
  '/mdx': 'MDX 示例',
  '/static': '静态页示例',
  '/components': '组件示例',
  '/inter': '交互示例'
};

const crumbs: { label: string; href?: string }[] = [];
if (path !== '/') {
  crumbs.push({ label: '首页', href: '/' });
  if (path === '/zsb') {
    crumbs.push({ label: '资料库' });
  } else if (path === '/zsb/wrong') {
    crumbs.push({ label: '资料库', href: '/zsb/' }, { label: '错题本' });
  } else if (path.startsWith('/zsb/')) {
    crumbs.push({ label: '资料库', href: '/zsb/' }, { label: title });
  } else {
    crumbs.push({ label: demos[path] ?? title });
  }
}

const inDocs = path.startsWith('/zsb') && path !== '/zsb/wrong';
const inWrong = path === '/zsb/wrong';
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | 专插本资料库</title>
    <meta name="description" content={title + " · 专插本历年真题与资料的结构化题库"} />
    <meta name="keywords" content="专插本, 题库, 真题, 民法, 政治理论" />
    <link rel="alternate" type="application/rss+xml" title="专插本资料库 RSS" href="/rss.xml" />
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="site-brand" href="/">专插本资料库</a>
        <nav class="site-nav" aria-label="主导航">
          <a href="/zsb/" class={inDocs ? 'site-nav-link is-current' : 'site-nav-link'} aria-current={inDocs ? 'page' : undefined}>资料库</a>
          <a href="/zsb/wrong/" class={inWrong ? 'site-nav-link is-current' : 'site-nav-link'} aria-current={inWrong ? 'page' : undefined}>错题本</a>
        </nav>
        <a class="legacy-entry" href="/zz/zsb/" title="适老化 / 旧浏览器基础版">长者版</a>
      </div>
    </header>

    {crumbs.length > 0 && (
      <nav class="site-crumb" aria-label="面包屑">
        <div class="site-crumb-inner">
          {crumbs.map((c, i) => (
            <Fragment>
              {i > 0 && <span class="site-crumb-sep">/</span>}
              {c.href ? (
                <a href={c.href}>{c.label}</a>
              ) : (
                <span class="site-crumb-current" aria-current="page">{c.label}</span>
              )}
            </Fragment>
          ))}
        </div>
      </nav>
    )}

    <slot />
  </body>
</html>
